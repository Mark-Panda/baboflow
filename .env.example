# ===== BaboFlow 后端配置（复制为 .env 使用；.env 不入版本库）=====

# HTTP / gRPC 监听：HTTP 默认 :8000；gRPC 默认仅 loopback :9000，
# 生产环境不得直接公网暴露 gRPC，需受控访问时通过防火墙/专用网络显式覆盖。
HTTP_ADDR=:8000
GRPC_ADDR=127.0.0.1:9000

# PostgreSQL（启用 pgvector）
DATABASE_DSN=host=127.0.0.1 user=babo password=babo dbname=baboflow port=5432 sslmode=disable

# 敏感信息加密密钥（32 字节，生产务必修改）
BABO_SECRET=please-change-me-32bytes-secret!!

# Langfuse 观测（可选）
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Agent 内置工具沙箱目录（bash/read/write/edit/grep）
BABO_WORKSPACE=./workspace

# 规则链执行并发
EXECUTOR_WORKERS=8

# bash 工具命令白名单（逗号分隔；空=黑名单模式）
BASH_ALLOWLIST=

# 向量维度与生成向量所用模型（llm_model.id）
EMBEDDING_DIM=1536
EMBEDDING_MODEL_ID=0

# 组件 SKILL 是否用 LLM 润色（默认 false 走模板）
COMPONENT_SKILL_LLM=false

# 首次启动 admin 初始密码（登录后强制改密）
ADMIN_INIT_PASSWORD=admin123

# /mcp SSE 端点 Bearer 令牌（外部 MCP 客户端无 Cookie 时使用；空=仅接受已登录会话）。
# 该端点会执行已发布规则链，生产环境强烈建议设置一个强随机值。
MCP_AUTH_TOKEN=

# ---- 飞书自建应用 OAuth 登录（直连 open.feishu.cn；三者缺一则飞书登录不可用）----
# 在飞书开放平台给 baboflow 建自建应用，开通获取用户信息权限，
# 并把重定向 URL 配置为下面的 FEISHU_REDIRECT_URI。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 与飞书后台配置的重定向 URL 完全一致，如 https://baboflow.example.com/api/v1/auth/feishu/callback
FEISHU_REDIRECT_URI=
